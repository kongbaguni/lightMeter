xcuserdata/
*.xcuserstate

# Build products
build/
DerivedData/
*.ipa
*.xcarchive

# SwiftPM
.swiftpm/
.build/

# Xcode workspace
xcshareddata/WorkspaceSettings.xcsettings

# iOS device support
DeviceSupport/
Devices/

########################
# CocoaPods
########################
Pods/
Podfile.lock
# If you want deterministic builds, keep Podfile.lock

########################
# Carthage
########################
Carthage/Build/
Carthage/Checkouts/

########################
# Fastlane
########################
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

########################
# Firebase / Google
########################
GoogleService-Info.plist
# or encrypt / use CI secret

########################
