# misc
########################
*.DS_Store
*.swp
*.lock
*.tmp
*.orig
*.bak
*.env

# Prevent committing Xcode crash logs
*.xccrashpoint
*.crash

# Prevent committing provisioning profiles
*.mobileprovision
*.provisioningprofile
